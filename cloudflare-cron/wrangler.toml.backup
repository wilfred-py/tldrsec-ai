# Cloudflare Worker Configuration for TLDRSEC SEC Filing Monitoring
# This worker executes every 10 minutes to trigger SEC filing processing

name = "cloudflare-cron"
main = "index.js"
compatibility_date = "2024-12-01"
workers_dev = true

# Explicit build configuration for Cloudflare's new build system
[build]
command = ""
watch_dir = ""

# Cron schedule: Every 10 minutes
[triggers]
crons = ["*/10 * * * *"]

# Environment variables (non-sensitive)
[vars]
PUBLIC_URL = "https://tldrsec.app"
USE_ASYNC_PROCESSING = "true"
DEBUG_MODE = "true"  # Set to "false" in production for reduced logging
WORKER_VERSION = "2.3.0-enhanced"
RATE_LIMIT_STRATEGY = "adaptive-global-aware"

# IMPORTANT: Sensitive secrets must be added via Cloudflare Dashboard or wrangler CLI:
# - CRON_SECRET (required for API authentication) - CRITICAL
# - VERCEL_AUTOMATION_BYPASS_SECRET (optional for deployment protection)
# - OPENROUTER_API_KEY (if using OpenRouter for AI processing)
# - DEFAULT_AI_MODEL (model configuration)
#
# Required Commands:
#   npx wrangler secret put CRON_SECRET
#   npx wrangler secret put VERCEL_AUTOMATION_BYPASS_SECRET (optional)
#
# Verify secrets with: npx wrangler secret list

# Enhanced logging for production monitoring
[observability.logs]
enabled = true

# Enhanced KV storage for advanced rate limiting, circuit breaker state persistence, and monitoring
# IMPORTANT: Replace placeholder IDs with actual KV namespace IDs from Cloudflare Dashboard
# Create KV namespaces with: 
#   npx wrangler kv:namespace create "RATE_LIMIT_KV"
#   npx wrangler kv:namespace create "CIRCUIT_BREAKER_KV" 
#   npx wrangler kv:namespace create "METRICS_KV"
#   npx wrangler kv:namespace create "RATE_LIMIT_KV" --preview
#   npx wrangler kv:namespace create "CIRCUIT_BREAKER_KV" --preview
#   npx wrangler kv:namespace create "METRICS_KV" --preview

[[kv_namespaces]]
binding = "RATE_LIMIT_KV"
preview_id = "REPLACE_WITH_ACTUAL_PREVIEW_ID" # Replace with actual preview namespace ID
id = "REPLACE_WITH_ACTUAL_PRODUCTION_ID"     # Replace with actual production namespace ID

[[kv_namespaces]]
binding = "CIRCUIT_BREAKER_KV"
preview_id = "REPLACE_WITH_ACTUAL_PREVIEW_ID" # Replace with actual preview namespace ID
id = "REPLACE_WITH_ACTUAL_PRODUCTION_ID"     # Replace with actual production namespace ID

[[kv_namespaces]]
binding = "METRICS_KV"
preview_id = "REPLACE_WITH_ACTUAL_PREVIEW_ID" # Replace with actual preview namespace ID
id = "REPLACE_WITH_ACTUAL_PRODUCTION_ID"     # Replace with actual production namespace ID

# Build configuration for robust deployment
# Note: upload exclusions are handled automatically by wrangler
# for common patterns like node_modules, .git, etc.
