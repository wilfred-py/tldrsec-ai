{
  "buildCommand": "npm run build",
  "crons": [
    {
      "path": "/api/cron/tier-aware",
      "schedule": "0 9 * * 1,2,3,4,5"
    }
  ],
  "functions": {
    "app/api/cron/tier-aware/route.ts": {
      "maxDuration": 300,
      "memory": 1024
    },
    "app/api/cron/process-filing-queue/route.ts": {
      "maxDuration": 180,
      "memory": 1024
    },
    "app/api/filings/enhanced-summary/route.ts": {
      "maxDuration": 300,
      "memory": 2048
    },
    "app/api/email/summary/route.ts": {
      "maxDuration": 60,
      "memory": 512
    },
    "app/api/email/welcome/route.ts": {
      "maxDuration": 30,
      "memory": 256
    },
    "app/api/monitoring/pipeline-health/route.ts": {
      "maxDuration": 60,
      "memory": 512
    }
  },
  "headers": [
    {
      "source": "/api/cron/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/api/health/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, max-age=0"
        }
      ]
    },
    {
      "source": "/api/test/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/api/debug/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/api/monitoring/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, max-age=0"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, POST, PATCH, DELETE, OPTIONS"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/health",
      "destination": "/api/health"
    },
    {
      "source": "/health/database",
      "destination": "/api/health/database"
    },
    {
      "source": "/health/liveness",
      "destination": "/api/health/liveness"
    },
    {
      "source": "/health/readiness",
      "destination": "/api/health/readiness"
    },
    {
      "source": "/monitoring/health",
      "destination": "/api/monitoring/pipeline-health"
    },
    {
      "source": "/monitoring/alerts",
      "destination": "/api/monitoring/error-alerts"
    },
    {
      "source": "/monitoring/trends",
      "destination": "/api/monitoring/health-trends"
    },
    {
      "source": "/monitoring/metrics",
      "destination": "/api/monitoring/metrics"
    }
  ],
  "regions": ["iad1"],
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "framework": "nextjs",
  "env": {
    "NODE_ENV": "production",
    "VERCEL_ENV": "production"
  }
}