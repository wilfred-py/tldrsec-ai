{
  "buildCommand": "npm run build",
  "crons": [
    {
      "path": "/api/cron/monitor-sec-filings",
      "schedule": "0 9 * * 1,2,3,4,5"
    },
    {
      "path": "/api/cron/process-jobs",
      "schedule": "0 12 * * 1,2,3,4,5"
    }
  ],
  "functions": {
    "app/api/cron/monitor-sec-filings/route.ts": {
      "maxDuration": 10,
      "memory": 1024
    },
    "app/api/cron/tier-aware/route.ts": {
      "maxDuration": 10,
      "memory": 1024
    },
    "app/api/cron/tier-aware-optimized/route.ts": {
      "maxDuration": 10,
      "memory": 1024
    },
    "app/api/cron/tier-aware-async/route.ts": {
      "maxDuration": 10,
      "memory": 1024
    },
    "app/api/cron/microservices/route.ts": {
      "maxDuration": 10,
      "memory": 512
    },
    "app/api/cron/process-jobs/route.ts": {
      "maxDuration": 10,
      "memory": 1024
    },
    "app/api/cron/unified/route.ts": {
      "maxDuration": 10,
      "memory": 1024
    },
    "app/api/jobs/worker/route.ts": {
      "maxDuration": 10,
      "memory": 1024
    },
    "app/api/jobs/process/route.ts": {
      "maxDuration": 10,
      "memory": 1024
    },
    "app/api/jobs/status/route.ts": {
      "maxDuration": 10,
      "memory": 512
    },
    "app/api/filings/async-summary/route.ts": {
      "maxDuration": 10,
      "memory": 1024
    },
    "app/api/test/ai-summary/route.ts": {
      "maxDuration": 10,
      "memory": 1024
    },
    "app/api/test/filing-summary/route.ts": {
      "maxDuration": 10,
      "memory": 1024
    },
    "app/api/test/tsla-email-summary/route.ts": {
      "maxDuration": 10,
      "memory": 1024
    },
    "app/api/email/filings-summary/route.ts": {
      "maxDuration": 10,
      "memory": 512
    },
    "app/api/email/summary/route.ts": {
      "maxDuration": 10,
      "memory": 512
    },
    "app/api/email/welcome/route.ts": {
      "maxDuration": 10,
      "memory": 256
    }
  },
  "headers": [
    {
      "source": "/api/cron/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/api/health/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, max-age=0"
        }
      ]
    },
    {
      "source": "/api/test/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/api/debug/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/health",
      "destination": "/api/health"
    },
    {
      "source": "/health/database",
      "destination": "/api/health/database"
    },
    {
      "source": "/health/liveness",
      "destination": "/api/health/liveness"
    },
    {
      "source": "/health/readiness",
      "destination": "/api/health/readiness"
    }
  ],
  "regions": ["iad1"],
  "env": {
    "NODE_ENV": "production",
    "VERCEL_ENV": "production"
  }
}