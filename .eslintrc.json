{
  "ignorePatterns": [
    "node_modules/",
    ".next/",
    "out/",
    "public/",
    "lib/generated/**",
    "lib/sec-edgar/**",
    "lib/parsers/**",
    "lib/job-queue/**",
    "lib/monitoring/**",
    "lib/logging/**"
  ],
  "overrides": [
    {
      "files": ["**/__tests__/**", "**/*.test.*", "**/*.spec.*"],
      "rules": {
        "@typescript-eslint/no-explicit-any": "off",
        "@typescript-eslint/no-require-imports": "off",
        "@typescript-eslint/no-unused-vars": "warn"
      }
    }
  ]
} 