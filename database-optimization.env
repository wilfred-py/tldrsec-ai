# Database Connection Optimization for Neon PostgreSQL
# Add these parameters to your DATABASE_URL in Vercel environment variables

# Recommended DATABASE_URL format:
# postgresql://user:password@host:port/database?connection_limit=50&pool_timeout=30&connection_timeout=20000&statement_timeout=60000&query_timeout=30000

# Connection Pool Settings
connection_limit=50              # Increase from default 21 to handle concurrent cron jobs
pool_timeout=30                  # 30 second timeout for acquiring connections
connection_timeout=20000         # 20 second timeout for establishing connections

# Query Performance Settings  
statement_timeout=60000          # 60 second limit for individual statements
query_timeout=30000              # 30 second timeout for complex queries
idle_in_transaction_session_timeout=300000  # 5 minutes for idle transactions

# For High-Concurrency Cron Processing
pgbouncer=true                   # Enable connection pooling if available
prepare_threshold=5              # Optimize prepared statements
lock_timeout=30000              # 30 second lock timeout

# Production Monitoring
log_connections=on              # Track connection patterns
log_disconnections=on           # Monitor connection cleanup
log_duration=on                 # Log slow queries
log_min_duration_statement=1000 # Log queries taking >1 second