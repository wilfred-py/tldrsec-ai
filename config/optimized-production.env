# Optimized Filing Services Production Configuration - Tranche 5
# 
# Production environment variables for optimized filing architecture
# Copy these to your production environment and adjust values as needed

# Core Feature Flags
ENABLE_OPTIMIZED_FILING=true
OPTIMIZED_TRAFFIC_PERCENTAGE=10

# Database Configuration
DATABASE_URL=postgresql://user:password@host:5432/database
DATABASE_POOL_SIZE=20
DATABASE_TIMEOUT=30000

# Claude AI Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-3-5-sonnet-20241022
CLAUDE_TEMPERATURE=0.3
CLAUDE_MAX_TOKENS=4000
CLAUDE_RATE_LIMITING=true
CLAUDE_MAX_REQUESTS_PER_MINUTE=50
CLAUDE_MAX_TOKENS_PER_REQUEST=190000

# Cache Configuration
ENABLE_IN_MEMORY_CACHE=true
ENABLE_DATABASE_CACHE=true
ENABLE_REDIS_CACHE=false
CACHE_TIMEOUT_SECONDS=3600
REDIS_URL=redis://localhost:6379

# Performance Configuration
ENABLE_CHUNKING=true
BATCH_PROCESSING_ENABLED=true
BATCH_CONCURRENCY=5
PRIORITIZE_SPEED=true

# Security Configuration
CLERK_SECRET_KEY=your_clerk_secret_key_here
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here

# Email Configuration
RESEND_API_KEY=your_resend_api_key_here

# Monitoring Configuration
ENABLE_PERFORMANCE_MONITORING=true
ENABLE_ERROR_TRACKING=true
LOG_LEVEL=info

# Application Configuration
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://your-domain.com
PORT=3000

# Health Check Configuration
HEALTH_CHECK_TIMEOUT=30000
ENABLE_DETAILED_HEALTH_CHECKS=true

# Rate Limiting Configuration
API_RATE_LIMIT_REQUESTS_PER_MINUTE=100
API_RATE_LIMIT_BURST=20

# Resource Limits
MAX_CONCURRENT_REQUESTS=50
MAX_FILING_SIZE_MB=10
MAX_BATCH_SIZE=25

# Fallback Configuration
ENABLE_LEGACY_FALLBACK=true
FALLBACK_TIMEOUT_MS=60000

# Development/Debug (disable in production)
ENABLE_DEBUG_LOGGING=false
ENABLE_API_METRICS=true
ENABLE_TIMING_LOGS=true