# API Keys (Required to enable respective provider)
ANTHROPIC_API_KEY=your_anthropic_api_key_here       # Required: Format: sk-ant-api03-...
PERPLEXITY_API_KEY=your_perplexity_api_key_here     # Optional: Format: pplx-...
OPENAI_API_KEY=your_openai_api_key_here             # Optional, for OpenAI/OpenRouter models. Format: sk-proj-...
GOOGLE_API_KEY=your_google_api_key_here             # Optional, for Google Gemini models.
MISTRAL_API_KEY=your_mistral_key_here               # Optional, for Mistral AI models.
XAI_API_KEY=YOUR_XAI_KEY_HERE                       # Optional, for xAI AI models.
AZURE_OPENAI_API_KEY=your_azure_key_here            # Optional, for Azure OpenAI models (requires endpoint in .taskmasterconfig).
# Model Configuration
ANTHROPIC_MODEL=claude-sonnet-4-20250514  # Default model for Claude API calls

# Admin Configuration (Production Configuration)
# Set this to the email address of the system administrator
# This user will have access to monitoring dashboards and admin features
ADMIN_EMAIL=admin@yourcompany.com

# Database Configuration (Supabase)
# Transaction mode (port 6543) - Use for all Prisma queries
# Format: postgres://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=postgres://postgres.your-project-ref:your-password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Session mode (port 5432) - Used for Prisma migrations only
# Format: postgres://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
DIRECT_URL=postgres://postgres.your-project-ref:your-password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# IMPORTANT: Do NOT use Neon database URLs. This project uses Supabase with multi-schema architecture.
# The app requires 'app' and 'pipeline' schemas that only exist in the Supabase database.

# Clerk Authentication (Required for user authentication)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key

# SEC EDGAR API Configuration
SEC_USER_AGENT=YourCompany contact@yourcompany.com

# Email Service Configuration (for notifications)
RESEND_API_KEY=re_your_resend_api_key_here

# Enhanced Summarization Configuration (Optional)
ENABLE_ENHANCED_SUMMARIZATION=true
ENHANCED_CHUNK_SIZE=50000
ENHANCED_MAX_CHUNKS=10
ENHANCED_MAX_RETRIES=3

# Rate Limiting Configuration
ENHANCED_CHUNKING_STRATEGY=CONSERVATIVE
ENHANCED_SINGLE_LIMIT=75000

# Cron Job Configuration (Required for Railway/Production)
CRON_SECRET=your_secure_cron_secret_here
# Note: RAILWAY_PUBLIC_DOMAIN is automatically provided by Railway (e.g., your-app.up.railway.app)

# Cookie Security Configuration (Required for A/B testing)
COOKIE_SECRET=your_secure_32_char_cookie_secret_here

# Landing Page Feature Flags
NEXT_PUBLIC_LANDING_PAGE_ENABLED=true      # Set to 'true' to show landing page (vs redirect to /waitlist)
NEXT_PUBLIC_LANDING_V2_ENABLED=false       # Set to 'true' to enable new V2 light theme design (for A/B testing)

# Testing Configuration (Required for E2E tests)
TEST_EMAIL=your_test_email@example.com

# AI Rate Limiting Configuration (Optional - has defaults)
AI_ENABLE_RATE_LIMITING=true
AI_ENABLE_COST_TRACKING=true

# Per-User Rate Limits (per hour)
AI_USER_REQUESTS_PER_HOUR=100
AI_USER_TOKENS_PER_HOUR=50000
AI_USER_COST_PER_HOUR=10.0

# Per-User Daily Limits
AI_USER_REQUESTS_PER_DAY=1000
AI_USER_TOKENS_PER_DAY=500000
AI_USER_COST_PER_DAY=100.0

# Global Rate Limits (per hour)
AI_GLOBAL_REQUESTS_PER_HOUR=10000
AI_GLOBAL_TOKENS_PER_HOUR=5000000
AI_GLOBAL_COST_PER_HOUR=1000.0

# Daily Budget Limits
AI_DAILY_BUDGET=100.0
AI_MONTHLY_BUDGET=3000.0

# Rate Limiting Behavior
AI_RATE_LIMIT_WINDOW_HOUR=3600000
AI_RATE_LIMIT_WINDOW_DAY=86400000
AI_FAIL_OPEN=true
AI_ALERT_THRESHOLD=0.8

# Redis Configuration (for distributed rate limiting)
REDIS_URL=redis://localhost:6379

# Slack Pipeline Monitor Configuration (Optional - for real-time pipeline notifications)
# Create a Slack App at https://api.slack.com/apps
# 1. Enable Incoming Webhooks and create one for your channel
# 2. Add Bot Token Scopes: chat:write, app_mentions:read
# 3. Install to workspace and copy Bot Token
# 4. Get Signing Secret from Basic Information page
# 5. Configure Event Subscriptions URL: https://tldrsec.app/api/slack/events
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../...
SLACK_ALERTS_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../...  # Optional: separate webhook for alerts
SLACK_BOT_TOKEN=xoxb-your-bot-token  # For @mention responses
SLACK_SIGNING_SECRET=your_signing_secret  # For verifying incoming events

# Supabase Configuration (Required for production)
# Get these from: https://app.supabase.com/project/ipwlykhekrjfvejduotm/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://ipwlykhekrjfvejduotm.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_anon_key_here
# Note: Use SUPABASE_SERVICE_ROLE_KEY (standard naming) or SUPABASE_SECRET_KEY (legacy)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
