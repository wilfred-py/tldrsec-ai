# Stripe Price IDs - Monthly Plans
STRIPE_BASIC_MONTHLY_PRICE_ID="price_..." # Basic plan monthly ($9)
STRIPE_PROFESSIONAL_MONTHLY_PRICE_ID="price_..." # Professional plan monthly ($29)
STRIPE_PREMIUM_MONTHLY_PRICE_ID="price_..." # Premium plan monthly ($99)

# Stripe Price IDs - Yearly Plans
STRIPE_BASIC_YEARLY_PRICE_ID="price_..." # Basic plan yearly ($90 - save 17%)
STRIPE_PROFESSIONAL_YEARLY_PRICE_ID="price_..." # Professional plan yearly ($290 - save 17%)
STRIPE_PREMIUM_YEARLY_PRICE_ID="price_..." # Premium plan yearly ($990 - save 17%)

# Application Configuration
