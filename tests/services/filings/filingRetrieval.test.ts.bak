import { describe, it, expect, vi, beforeEach, afterEach } from 'vitest';
import axios from 'axios';
import { getFilingContent } from '../../../services/filings/filingRetrieval';
import { SECEdgarClient } from '../../../lib/sec-edgar/client';

// Mock the SEC Edgar client
vi.mock('../../../lib/sec-edgar/client', () => {
  return {
    SECEdgarClient: vi.fn().mockImplementation(() => {
      return {
        getFilingDocument: vi.fn()
      };
    })
  };
});

// Mock axios
vi.mock('axios');

// Mock the logger
vi.mock('../../../lib/logging', () => {
  return {
    logger: {
      debug: vi.fn(),
      info: vi.fn(),
      warn: vi.fn(),
      error: vi.fn()
    }
  };
});

describe('Filing Retrieval Service', () => {
  let mockSECClient: { getFilingDocument: ReturnType<typeof vi.fn> };
  
  beforeEach(() => {
    // Clear all mocks before each test
    vi.clearAllMocks();
    
    // Setup the mock SEC client
    mockSECClient = {
      getFilingDocument: vi.fn()
    };
    
    (SECEdgarClient as unknown as ReturnType<typeof vi.fn>).mockImplementation(() => mockSECClient);
  });
  
  afterEach(() => {
    vi.resetAllMocks();
  });
  
  describe('getFilingContent', () => {
    const accessionNumber = '0001950047-25-004884';
    const cik = '0001318605';
    const formattedCik = '1318605';
    const formattedAccessionNumber = '000195004725004884';
    const baseUrl = `https://www.sec.gov/Archives/edgar/data/${formattedCik}/${formattedAccessionNumber}`;
    
    it('should try multiple URL patterns until one succeeds', async () => {
      // Mock the first two patterns to fail and the third to succeed
      mockSECClient.getFilingDocument
        .mockRejectedValueOnce(new Error('404 Not Found'))
        .mockRejectedValueOnce(new Error('404 Not Found'))
        .mockResolvedValueOnce('Filing content');
      
      const result = await getFilingContent(accessionNumber, cik);
      
      // Verify the result
      expect(result).toBe('Filing content');
      
      // Verify that the client was called with the expected URLs
      expect(mockSECClient.getFilingDocument).toHaveBeenCalledTimes(3);
      expect(mockSECClient.getFilingDocument).toHaveBeenNthCalledWith(1, baseUrl, { handleNotFound: false });
      expect(mockSECClient.getFilingDocument).toHaveBeenNthCalledWith(2, `${baseUrl}/${accessionNumber}.txt`, { handleNotFound: false });
      expect(mockSECClient.getFilingDocument).toHaveBeenNthCalledWith(3, `${baseUrl}/${accessionNumber}-index.html`, { handleNotFound: false });
    });
    
    it('should throw an error if all URL patterns fail', async () => {
      // Mock all patterns to fail
      mockSECClient.getFilingDocument.mockRejectedValue(new Error('404 Not Found'));
      
      // Expect the function to throw an error
      await expect(getFilingContent(accessionNumber, cik)).rejects.toThrow(`No content found for filing ${accessionNumber}`);
      
      // Verify that the client was called with all URL patterns
      expect(mockSECClient.getFilingDocument).toHaveBeenCalledTimes(6);
    });
    
    it('should use the first successful URL pattern', async () => {
      // Mock the first pattern to succeed
      mockSECClient.getFilingDocument.mockResolvedValueOnce('Filing content');
      
      const result = await getFilingContent(accessionNumber, cik);
      
      // Verify the result
      expect(result).toBe('Filing content');
      
      // Verify that the client was called only once
      expect(mockSECClient.getFilingDocument).toHaveBeenCalledTimes(1);
      expect(mockSECClient.getFilingDocument).toHaveBeenCalledWith(baseUrl, { handleNotFound: false });
    });
    
    it('should handle primary document URLs', async () => {
      // Mock all patterns to fail except the primary document
      mockSECClient.getFilingDocument
        .mockRejectedValueOnce(new Error('404 Not Found'))
        .mockRejectedValueOnce(new Error('404 Not Found'))
        .mockRejectedValueOnce(new Error('404 Not Found'))
        .mockRejectedValueOnce(new Error('404 Not Found'))
        .mockRejectedValueOnce(new Error('404 Not Found'))
        .mockResolvedValueOnce('Filing content from primary doc');
      
      const result = await getFilingContent(accessionNumber, cik);
      
      // Verify the result
      expect(result).toBe('Filing content from primary doc');
      
      // Verify that the client was called with the primary document URL
      expect(mockSECClient.getFilingDocument).toHaveBeenCalledTimes(6);
      expect(mockSECClient.getFilingDocument).toHaveBeenNthCalledWith(6, `${baseUrl}/primary_doc.xml`, { handleNotFound: false });
    });
  });
});
