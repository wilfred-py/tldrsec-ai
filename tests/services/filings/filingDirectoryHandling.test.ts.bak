import { jest, describe, it, expect, beforeEach, afterEach } from '@jest/globals';
import axios from 'axios';
import { getFilingContent } from '../../../services/filings/filingRetrieval';
import { isDirectoryListing, extractDocumentLinks } from '../../../services/filings/extractors/documentScraper';

// Mock axios
jest.mock('axios');

interface AxiosResponse<T = any> {
  data: T;
  status: number;
  statusText: string;
  headers: any;
  config: any;
}

const mockedAxios = axios as jest.Mocked<typeof axios>;
mockedAxios.get = jest.fn() as jest.MockedFunction<typeof axios.get>;

// Mock the document scraper functions
jest.mock('../../../services/filings/extractors/documentScraper', () => {
  return {
    isDirectoryListing: jest.fn(),
    extractDocumentLinks: jest.fn()
  };
});

// Mock the logger
jest.mock('../../../lib/logging', () => {
  return {
    logger: {
      debug: jest.fn(),
      info: jest.fn(),
      warn: jest.fn(),
      error: jest.fn()
    }
  };
});

// Mock the SEC config
jest.mock('../../../config/sec', () => {
  return {
    SEC_CONFIG: {
      HEADERS: {
        'User-Agent': 'test-user-agent'
      }
    }
  };
});

describe('Filing Directory Handling', () => {
  const accessionNumber = '0001950047-25-004884';
  const cik = '0001318605';
  const formattedCik = '1318605';
  const formattedAccessionNumber = '000195004725004884';
  const baseUrl = `https://www.sec.gov/Archives/edgar/data/${formattedCik}/${formattedAccessionNumber}`;
  
  // Sample HTML content for a directory listing
  const directoryListingHTML = `
    <html>
      <head>
        <title>Index of /Archives/edgar/data/1318605/000195004725004884</title>
      </head>
      <body>
        <h1>Index of /Archives/edgar/data/1318605/000195004725004884</h1>
        <table>
          <tr><th>Name</th><th>Last modified</th><th>Size</th><th>Description</th></tr>
          <tr><td><a href="0001950047-25-004884-index-headers.html">0001950047-25-004884-index-headers.html</a></td><td>2025-07-02 16:17:41</td><td>2,345</td><td></td></tr>
          <tr><td><a href="0001950047-25-004884-index.html">0001950047-25-004884-index.html</a></td><td>2025-07-02 16:17:41</td><td>3,456</td><td></td></tr>
          <tr><td><a href="0001950047-25-004884.txt">0001950047-25-004884.txt</a></td><td>2025-07-02 16:17:41</td><td>12,345</td><td></td></tr>
          <tr><td><a href="primary_doc.xml">primary_doc.xml</a></td><td>2025-07-02 16:17:41</td><td>9,876</td><td></td></tr>
        </table>
      </body>
    </html>
  `;
  
  // Sample content for an actual filing document
  const actualFilingContent = `
    <XML>
      <Filing>
        <FormType>Form 4</FormType>
        <FilingDate>2025-07-02</FilingDate>
        <Content>This is the actual filing content</Content>
      </Filing>
    </XML>
  `;
  
  beforeEach(() => {
    // Clear all mocks before each test
    jest.clearAllMocks();
    
    // Reset the mocked functions
    (mockedAxios.get as jest.Mock).mockReset();
    (isDirectoryListing as jest.Mock).mockReset();
    (extractDocumentLinks as jest.Mock).mockReset();
  });
  
  afterEach(() => {
    jest.resetAllMocks();
  });
  
  it('should skip directory listings and continue to the next URL pattern', async () => {
    // Mock the directory listing detection
    (isDirectoryListing as jest.Mock)
      .mockReturnValueOnce(true)  // First response is a directory listing
      .mockReturnValueOnce(false); // Second response is not a directory listing
    
    // Mock axios responses
    (mockedAxios.get as jest.Mock)
      .mockResolvedValueOnce({ data: directoryListingHTML }) // First URL returns directory listing
      .mockResolvedValueOnce({ data: actualFilingContent });  // Second URL returns actual content
    
    const result = await getFilingContent(accessionNumber, cik);
    
    // Verify we got the actual filing content
    expect(result).toBe(actualFilingContent);
    
    // Verify isDirectoryListing was called correctly
    expect(isDirectoryListing).toHaveBeenCalledTimes(2);
    expect(isDirectoryListing).toHaveBeenCalledWith(directoryListingHTML);
    expect(isDirectoryListing).toHaveBeenCalledWith(actualFilingContent);
    
    // Verify mockedAxios.get was called with the expected URLs
    expect(mockedAxios.get).toHaveBeenCalledTimes(2);
  });
  
  it('should extract and fetch document links from directory listings as a last resort', async () => {
    // Mock all URL patterns to return directory listings except the extracted document
    (isDirectoryListing as jest.Mock)
      .mockReturnValue(true)  // All responses are directory listings
      .mockReturnValueOnce(true)  // First URL is directory listing
      .mockReturnValueOnce(true)  // Second URL is directory listing
      .mockReturnValueOnce(true)  // Third URL is directory listing
      .mockReturnValueOnce(true)  // Fourth URL is directory listing
      .mockReturnValueOnce(true)  // Fifth URL is directory listing
      .mockReturnValueOnce(true)  // Sixth URL is directory listing
      .mockReturnValueOnce(false); // Document from extracted link is not a directory listing
    
    // Mock document links extraction
    const extractedLinks = [
      `${baseUrl}/primary_doc.xml`,
      `${baseUrl}/0001950047-25-004884.txt`,
      `${baseUrl}/0001950047-25-004884-index.html`
    ];
    (extractDocumentLinks as jest.Mock).mockReturnValue(extractedLinks);
    
    // Mock axios responses for all URL patterns and extracted document
    (mockedAxios.get as jest.Mock)
      .mockResolvedValue({ data: directoryListingHTML }) // All URL patterns return directory listing
      .mockResolvedValueOnce({ data: directoryListingHTML })
      .mockResolvedValueOnce({ data: directoryListingHTML })
      .mockResolvedValueOnce({ data: directoryListingHTML })
      .mockResolvedValueOnce({ data: directoryListingHTML })
      .mockResolvedValueOnce({ data: directoryListingHTML })
      .mockResolvedValueOnce({ data: directoryListingHTML })
      .mockResolvedValueOnce({ data: actualFilingContent }); // Extracted document URL returns actual content
    
    const result = await getFilingContent(accessionNumber, cik);
    
    // Verify we got the actual filing content
    expect(result).toBe(actualFilingContent);
    
    // Verify extractDocumentLinks was called
    expect(extractDocumentLinks).toHaveBeenCalledTimes(1);
    expect(extractDocumentLinks).toHaveBeenCalledWith(directoryListingHTML, baseUrl);
    
    // Verify mockedAxios.get was called for all URL patterns and the extracted document
    expect(mockedAxios.get).toHaveBeenCalledTimes(7); // 6 URL patterns + 1 extracted document
  });
  
  it('should prioritize XML and text files when extracting document links', async () => {
    // Mock all URL patterns to return directory listings
    (isDirectoryListing as jest.Mock)
      .mockReturnValue(true)  // All URL pattern responses are directory listings
      .mockReturnValueOnce(false); // Document from extracted link is not a directory listing
    
    // Mock document links extraction with different file types
    const extractedLinks = [
      `${baseUrl}/some-html-file.html`,
      `${baseUrl}/primary_doc.xml`,  // Should be prioritized
      `${baseUrl}/0001950047-25-004884.txt`,  // Should be second priority
      `${baseUrl}/some-other-file.pdf`
    ];
    (extractDocumentLinks as jest.Mock).mockReturnValue(extractedLinks);
    
    // Mock axios responses
    (mockedAxios.get as jest.Mock)
      .mockResolvedValue({ data: directoryListingHTML }) // All URL patterns return directory listing
      .mockResolvedValueOnce({ data: directoryListingHTML })
      .mockResolvedValueOnce({ data: directoryListingHTML })
      .mockResolvedValueOnce({ data: directoryListingHTML })
      .mockResolvedValueOnce({ data: directoryListingHTML })
      .mockResolvedValueOnce({ data: directoryListingHTML })
      .mockResolvedValueOnce({ data: directoryListingHTML })
      .mockResolvedValueOnce({ data: actualFilingContent }); // XML file returns actual content
    
    const result = await getFilingContent(accessionNumber, cik);
    
    // Verify we got the actual filing content
    expect(result).toBe(actualFilingContent);
    
    // Verify mockedAxios.get was called with the XML file first (priority)
    expect(mockedAxios.get).toHaveBeenNthCalledWith(7, `${baseUrl}/primary_doc.xml`, expect.anything());
  });
  
  it('should throw an error if all attempts return directory listings or fail', async () => {
    // Mock all URL patterns and extracted documents to be directory listings
    (isDirectoryListing as jest.Mock).mockReturnValue(true);
    
    // Mock document links extraction
    const extractedLinks = [
      `${baseUrl}/primary_doc.xml`,
      `${baseUrl}/0001950047-25-004884.txt`
    ];
    (extractDocumentLinks as jest.Mock).mockReturnValue(extractedLinks);
    
    // Mock axios responses - all return directory listings
    (mockedAxios.get as jest.Mock).mockResolvedValue({ data: directoryListingHTML });
    
    // Expect the function to throw an error
    await expect(getFilingContent(accessionNumber, cik)).rejects.toThrow(
      `No valid filing content found for ${accessionNumber}`
    );
    
    // Verify we tried all URL patterns and extracted documents
    expect(mockedAxios.get).toHaveBeenCalledTimes(8); // 6 URL patterns + 2 extracted documents
  });
  
  it('should handle empty or invalid document links from directory listings', async () => {
    // Mock all URL patterns to return directory listings
    (isDirectoryListing as jest.Mock).mockReturnValue(true);
    
    // Mock document links extraction to return empty array
    (extractDocumentLinks as jest.Mock).mockReturnValue([]);
    
    // Mock axios responses
    (mockedAxios.get as jest.Mock).mockResolvedValue({ data: directoryListingHTML });
    
    // Expect the function to throw an error
    await expect(getFilingContent(accessionNumber, cik)).rejects.toThrow(
      `No valid filing content found for ${accessionNumber}`
    );
    
    // Verify extractDocumentLinks was called
    expect(extractDocumentLinks).toHaveBeenCalledTimes(1);
    
    // Verify we tried all URL patterns but no document links
    expect(mockedAxios.get).toHaveBeenCalledTimes(6); // 6 URL patterns, no extracted documents
  });
  
  it('should handle network errors when fetching documents', async () => {
    // Mock all URL patterns to fail with network errors
    (mockedAxios.get as jest.Mock).mockRejectedValue(new Error('Network Error'));
    
    // Expect the function to throw an error
    await expect(getFilingContent(accessionNumber, cik)).rejects.toThrow(
      `Failed to get filing content for ${accessionNumber}`
    );
    
    // Verify we tried all URL patterns
    expect(mockedAxios.get).toHaveBeenCalledTimes(6);
  });
});
