generator client {
  provider      = "prisma-client-js"
  output        = "../node_modules/.prisma/client"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String                 @id @default(uuid())
  email                 String                 @unique
  name                  String?
  authProvider          String
  authProviderId        String
  createdAt             DateTime               @default(now())
  preferences           Json?
  onboardingCompleted   Boolean                @default(false)
  tutorialCompletedAt   DateTime?
  tutorialProgress      Int                    @default(0)
  tutorialSteps         Json?
  subscriptionTier      SubscriptionTier       @default(FREE)
  lastProcessedAt       DateTime?
  lastCronProcessed     DateTime?
  processingBudget      Int                    @default(0)
  budgetUsed            Int                    @default(0)
  budgetResetAt         DateTime?
  dailyProcessingBudget Int                    @default(0)
  dailyBudgetResetAt    DateTime?
  tierProcessingCount   Int                    @default(0)
  lastTierUpgrade       DateTime?
  auditLogs             AuditLog[]
  filingUsage           FilingUsage[]
  notificationsSent     NotificationSent[]
  cacheAccesses         SummaryCacheAccess[]
  emailDeliveries       SummaryEmailDelivery[]
  tickers               Ticker[]
  usagePeriods          UsagePeriod[]
  userSubscription      UserSubscription?
}

model Ticker {
  id          String      @id @default(uuid())
  symbol      String
  companyName String
  userId      String
  addedAt     DateTime    @default(now())
  secFilings  SecFiling[]
  summaries   Summary[]
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, symbol])
}

model Summary {
  id                    String                 @id @default(uuid())
  tickerId              String
  filingType            String
  filingDate            DateTime
  filingUrl             String
  summaryText           String
  summaryJSON           Json?
  createdAt             DateTime               @default(now())
  sentToUser            Boolean                @default(false)
  url                   String?
  attempts              Int?                   @default(0)
  cost                  Float?
  isPartialResult       Boolean?               @default(false)
  model                 String?
  processingCompletedAt DateTime?
  processingError       String?
  processingErrorCode   String?
  processingStatus      String?
  processingTimeMs      Int?
  secFilingId           String?
  tokensUsed            Int?
  metadata              Json?
  cacheUsageCount       Int                    @default(0)
  cacheVersion          String?
  inputCostPerToken     Float?
  inputTokens           Int?
  isCacheHit            Boolean                @default(false)
  lastCacheUsed         DateTime?
  modelVersion          String?
  outputCostPerToken    Float?
  outputTokens          Int?
  promptVersion         String?
  totalCost             Float?
  totalEmailsSent       Int                    @default(0)
  uniqueUsersServed     Int                    @default(0)
  confidenceLevel       Float?
  extractionSuccess     Boolean                @default(true)
  parsingErrors         Int                    @default(0)
  qualityScore          Float?
  forceRefreshFlag      Boolean                @default(false)
  invalidatedBy         String?
  invalidationCount     Int                    @default(0)
  invalidationReason    String?
  lastInvalidatedAt     DateTime?
  secFiling             SecFiling?             @relation(fields: [secFilingId], references: [id])
  ticker                Ticker                 @relation(fields: [tickerId], references: [id], onDelete: Cascade)
  cacheAccesses         SummaryCacheAccess[]
  emailDeliveries       SummaryEmailDelivery[]
}

model CikMapping {
  id              String   @id @default(uuid())
  cik             String   @unique
  ticker          String
  companyName     String
  aliases         String[]
  exchangeCodes   String[]
  sic             String?
  ein             String?
  entityType      String?
  formerNames     Json?
  formerTickers   Json?
  lastUpdated     DateTime @default(now())
  fetchAttempts   Int      @default(0)
  lastFetchStatus String?
  isActive        Boolean  @default(true)

  @@index([ticker])
  @@index([companyName])
}

model TickerChange {
  id            String   @id @default(uuid())
  oldTicker     String
  newTicker     String
  oldCik        String?
  newCik        String?
  effectiveDate DateTime
  changeType    String
  description   String?
  createdAt     DateTime @default(now())

  @@index([oldTicker])
  @@index([newTicker])
  @@index([effectiveDate])
}

model JobQueue {
  id             String        @id @default(uuid())
  jobType        String
  status         String
  priority       Int           @default(5)
  payload        Json
  idempotencyKey String?
  createdAt      DateTime      @default(now())
  scheduledFor   DateTime
  startedAt      DateTime?
  completedAt    DateTime?
  failedAt       DateTime?
  retryCount     Int           @default(0)
  maxRetries     Int           @default(3)
  lastError      String?
  executionTime  Int?
  result         Json?
  costUSD        Decimal?      @db.Decimal(10, 4)
  timeoutFlagged Boolean       @default(false)
  tokenUsage     Json?
  progress       JobProgress[]

  @@index([status, scheduledFor])
  @@index([jobType, status])
  @@index([idempotencyKey])
  @@index([createdAt])
  @@index([timeoutFlagged, createdAt])
}

model JobProgress {
  id        String   @id @default(uuid())
  jobId     String
  phase     String
  progress  Int
  details   Json?
  startedAt DateTime
  updatedAt DateTime @updatedAt
  job       JobQueue @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, updatedAt])
  @@index([phase, updatedAt])
}

model JobLock {
  id          String    @id @default(uuid())
  lockName    String    @unique
  acquiredBy  String
  acquiredAt  DateTime  @default(now())
  expiresAt   DateTime
  refreshedAt DateTime?
  released    Boolean   @default(false)

  @@index([lockName, released, expiresAt])
}

model SecFiling {
  id              String            @id @default(uuid())
  tickerId        String
  formType        String
  filingDate      DateTime
  secUrl          String
  accessionNumber String
  companyName     String?
  cik             String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  fetchAttempts   SecFetchAttempt[]
  ticker          Ticker            @relation(fields: [tickerId], references: [id], onDelete: Cascade)
  summaries       Summary[]

  @@index([tickerId, formType])
  @@index([accessionNumber])
}

model SecCompanyCache {
  id        Int      @id @default(1)
  data      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FilingContentCache {
  id              String   @id @default(cuid())
  accessionNumber String   @unique
  cik             String
  formType        String
  content         String   @db.Text
  contentLength   Int
  contentHash     String
  fetchedAt       DateTime @default(now())
  expiresAt       DateTime
  fetchDuration   Int
  fetchError      String?
  status          String   @default("CACHED")

  @@index([accessionNumber])
  @@index([expiresAt])
  @@index([status])
}

model SecFetchAttempt {
  id           String    @id @default(uuid())
  filingId     String
  attemptedAt  DateTime
  errorMessage String?
  status       String
  filing       SecFiling @relation(fields: [filingId], references: [id], onDelete: Cascade)

  @@index([filingId])
}

model NotificationSent {
  id               String   @id @default(uuid())
  userId           String
  filingId         String?
  summaryId        String?
  notificationType String
  emailId          String?
  emailAddress     String
  sentAt           DateTime @default(now())
  deliveryStatus   String   @default("sent")
  metadata         Json?
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, sentAt])
  @@index([notificationType, sentAt])
  @@index([emailId])
}

model TickerMonitoring {
  id                String           @id @default(uuid())
  cik               String           @unique
  symbol            String
  companyName       String
  isActive          Boolean          @default(true)
  rssUrl            String
  lastChecked       DateTime?
  lastAccessionSeen String?
  subscriberCount   Int              @default(0)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  version           Int              @default(0)
  filingChecks      RssFilingCheck[]

  @@index([isActive, lastChecked])
  @@index([cik])
  @@index([cik, version])
}

model RssFilingCheck {
  id                 String           @id @default(uuid())
  tickerMonitoringId String
  accessionNumber    String           @unique
  filingType         String
  filingDate         DateTime
  filingUrl          String
  rssEntryDate       DateTime
  processed          Boolean          @default(false)
  createdAt          DateTime         @default(now())
  tickerMonitoring   TickerMonitoring @relation(fields: [tickerMonitoringId], references: [id], onDelete: Cascade)

  @@index([processed, createdAt])
  @@index([tickerMonitoringId, processed])
}

model UserSubscription {
  id                   String   @id @default(uuid())
  userId               String   @unique
  planType             PlanType @default(BASIC)
  isActive             Boolean  @default(true)
  currentPeriodStart   DateTime @default(now())
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean  @default(false)
  stripeCustomerId     String?  @unique
  stripeSubscriptionId String?  @unique
  stripePriceId        String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([planType, isActive])
}

model FilingUsage {
  id                  String   @id @default(uuid())
  userId              String
  filingType          String
  ticker              String
  accessionNumber     String?
  optimizationLevel   String
  originalTokens      Int?
  optimizedTokens     Int?
  reductionPercentage Float?
  cost                Float?
  processingTimeMs    Int?
  subscriptionTier    String
  createdAt           DateTime @default(now())
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([subscriptionTier, createdAt])
  @@index([filingType, createdAt])
}

model UsagePeriod {
  id          String   @id @default(uuid())
  userId      String
  periodStart DateTime
  periodEnd   DateTime
  planType    PlanType
  filingLimit Int
  filingsUsed Int      @default(0)
  resetAt     DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, periodStart])
  @@index([userId, periodEnd])
}

model CronJobExecution {
  id               String               @id @default(uuid())
  jobName          String
  executionId      String               @unique
  status           CronJobStatus
  startedAt        DateTime
  completedAt      DateTime?
  durationMs       Int?
  environment      String
  cronExpression   String?
  batchSize        Int?
  maxConcurrent    Int?
  timeoutMs        Int?
  tickersChecked   Int                  @default(0)
  newFilingsFound  Int                  @default(0)
  filingsProcessed Int                  @default(0)
  emailsSent       Int                  @default(0)
  errorsCount      Int                  @default(0)
  memoryUsageMb    Float?
  cpuUsagePercent  Float?
  errorMessage     String?
  errorStack       String?
  createdAt        DateTime             @default(now())
  alerts           CronJobAlert[]
  metrics          CronJobMetrics[]
  performance      CronJobPerformance[]

  @@index([jobName, startedAt])
  @@index([status, startedAt])
  @@index([startedAt])
  @@index([executionId])
}

model CronJobMetrics {
  id                    String           @id @default(uuid())
  executionId           String
  filingsByType         Json?
  companiesProcessed    Json?
  filingDates           Json?
  avgProcessingTimeMs   Float?
  usersAffected         Int              @default(0)
  uniqueEmailRecipients Int              @default(0)
  emailDeliveryRate     Float?
  emailBounceRate       Float?
  aiCostTotal           Float            @default(0)
  aiTokensUsed          Int              @default(0)
  aiTokensInput         Int              @default(0)
  aiTokensOutput        Int              @default(0)
  emailCostTotal        Float            @default(0)
  operationalCostTotal  Float            @default(0)
  costPerFiling         Float?
  costPerUser           Float?
  summariesPerDollar    Float?           // Key metric: summaries generated per dollar spent
  avgMemoryUsageMb      Float?
  peakMemoryUsageMb     Float?
  dbQueryCount          Int?
  avgDbQueryTimeMs      Float?
  apiCallCount          Int?
  avgApiResponseTimeMs  Float?
  secApiCallCount       Int?
  avgSecApiResponseMs   Float?
  filingsPerMinute      Float?
  emailsPerMinute       Float?
  createdAt             DateTime         @default(now())
  execution             CronJobExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId])
}

model CronJobAlert {
  id                 String            @id @default(uuid())
  executionId        String?
  alertType          CronAlertType
  severity           AlertSeverity
  title              String
  description        String
  threshold          Json?
  actualValue        Json?
  triggeredAt        DateTime          @default(now())
  acknowledgedAt     DateTime?
  acknowledgedBy     String?
  resolvedAt         DateTime?
  resolvedBy         String?
  notificationsSent  Json?
  notificationStatus String?
  jobName            String?
  environment        String?
  execution          CronJobExecution? @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([alertType, triggeredAt])
  @@index([severity, triggeredAt])
  @@index([jobName, triggeredAt])
  @@index([resolvedAt])
}

model CronJobPerformance {
  id                  String           @id @default(uuid())
  executionId         String
  timestamp           DateTime
  phase               String
  memoryUsageMb       Float
  cpuUsagePercent     Float?
  activeConnections   Int?
  queueDepth          Int?
  operationType       String?
  operationDurationMs Int?
  operationSuccess    Boolean?
  operationError      String?
  itemsProcessed      Int?
  itemsRemaining      Int?
  execution           CronJobExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId, timestamp])
  @@index([phase, timestamp])
  @@index([operationType, timestamp])
}

model CronJobDailySummary {
  id                    String   @id @default(uuid())
  date                  DateTime @unique @db.Date
  jobName               String
  totalExecutions       Int      @default(0)
  successfulExecutions  Int      @default(0)
  failedExecutions      Int      @default(0)
  avgDurationMs         Float?
  totalDurationMs       Int      @default(0)
  totalFilingsProcessed Int      @default(0)
  totalEmailsSent       Int      @default(0)
  totalUsersAffected    Int      @default(0)
  totalAiCost           Float    @default(0)
  totalEmailCost        Float    @default(0)
  totalOperationalCost  Float    @default(0)
  avgMemoryUsageMb      Float?
  peakMemoryUsageMb     Float?
  totalApiCalls         Int      @default(0)
  totalAlerts           Int      @default(0)
  criticalAlerts        Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([date, jobName])
  @@index([jobName, date])
}

model TierProcessingMetrics {
  id                String           @id @default(uuid())
  date              DateTime         @default(now()) @db.Date
  tier              SubscriptionTier
  usersProcessed    Int              @default(0)
  usersEligible     Int              @default(0)
  usersSkipped      Int              @default(0)
  avgProcessingTime Float?
  filingsProcessed  Int              @default(0)
  budgetUsed        Float            @default(0)
  budgetLimit       Float            @default(0)
  costPerUser       Float?
  marketHoursRuns   Int              @default(0)
  offHoursRuns      Int              @default(0)
  priorityProcessed Int              @default(0)
  errorCount        Int              @default(0)
  timeoutCount      Int              @default(0)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([date, tier])
  @@index([date, tier])
  @@index([tier, createdAt])
}

model TierProcessingExecution {
  id               String           @id @default(uuid())
  executionId      String
  tier             SubscriptionTier
  isMarketHours    Boolean
  startedAt        DateTime         @default(now())
  completedAt      DateTime?
  status           ExecutionStatus  @default(RUNNING)
  usersEligible    Int              @default(0)
  usersProcessed   Int              @default(0)
  usersSkipped     Int              @default(0)
  userErrors       Int              @default(0)
  filingsFound     Int              @default(0)
  filingsProcessed Int              @default(0)
  filingsErrors    Int              @default(0)
  processingTimeMs Int?
  budgetUsed       Float            @default(0)
  avgTimePerUser   Float?
  batchSize        Int              @default(0)
  priority         Int              @default(0)
  frequency        Int              @default(0)
  errorMessage     String?
  errorStack       String?

  @@index([executionId])
  @@index([tier, startedAt])
  @@index([isMarketHours, tier])
}

model CronExecutionContext {
  id                   String   @id @default(uuid())
  executionId          String   @unique
  isMarketHours        Boolean
  marketTimeZone       String   @default("America/New_York")
  totalUsersEligible   Int      @default(0)
  tierBreakdown        Json?
  globalBudgetLimit    Decimal  @default(0)
  globalBudgetUsed     Decimal  @default(0)
  budgetAlerts         Json?
  usersProcessedByTier Json?
  avgProcessingByTier  Json?
  budgetUtilization    Float?
  avgLatency           Int      @default(0)
  errorCount           Int      @default(0)
  successRate          Float?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([executionId])
  @@index([isMarketHours, createdAt])
}

model SummaryCacheAccess {
  id         String   @id @default(uuid())
  summaryId  String
  userId     String
  accessedAt DateTime @default(now())
  accessType String
  summary    Summary  @relation(fields: [summaryId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([summaryId, accessedAt])
  @@index([userId, accessedAt])
}

model SummaryEmailDelivery {
  id             String   @id @default(uuid())
  summaryId      String
  userId         String
  emailAddress   String
  sentAt         DateTime @default(now())
  deliveryStatus String   @default("sent")
  emailServiceId String?
  metadata       Json?
  summary        Summary  @relation(fields: [summaryId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, summaryId], name: "unique_user_summary_email")
  @@index([summaryId, sentAt])
  @@index([userId, sentAt])
  @@index([deliveryStatus, sentAt])
  @@index([userId, summaryId], map: "idx_email_deduplication_lookup")
}

model AuditLog {
  id           String   @id @default(uuid())
  userId       String
  action       String
  details      Json
  ipAddress    String?
  userAgent    String?
  success      Boolean  @default(true)
  errorMessage String?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
}

model CacheInvalidation {
  id                String   @id @default(uuid())
  correlationId     String   @unique
  requesterId       String
  environment       String
  reason            String
  criteria          Json
  summariesAffected String[]
  invalidatedCount  Int
  strategy          String
  executionTimeMs   Int
  success           Boolean
  errorMessage      String?
  createdAt         DateTime @default(now())

  @@index([environment, createdAt])
  @@index([requesterId, createdAt])
  @@index([correlationId])
  @@index([strategy, createdAt])
}

model PipelineHealthHistory {
  id                String   @id @default(uuid())
  timestamp         DateTime @default(now())
  pipelineStatus    String
  processingLatency Int
  successRate       Float
  errorCount        Int
  activeJobs        Int
  queueDepth        Int
  memoryUsage       Float
  cpuUsage          Float?
  metadata          Json?
  createdAt         DateTime @default(now())

  @@index([timestamp])
  @@index([pipelineStatus])
}

model ErrorAlert {
  id             String    @id @default(uuid())
  alertType      String
  source         String
  message        String
  errorCode      String?
  stackTrace     String?
  context        Json?
  resolved       Boolean   @default(false)
  resolvedAt     DateTime?
  notifiedAt     DateTime?
  escalatedAt    DateTime?
  acknowledgedAt DateTime?
  acknowledgedBy String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([alertType])
  @@index([source])
  @@index([resolved])
  @@index([createdAt])
}

model MonitoringThreshold {
  id                  String   @id @default(uuid())
  metricName          String
  thresholdType       String
  operator            String
  value               Float
  enabled             Boolean  @default(true)
  alertFrequencyMins  Int      @default(15)
  escalationDelayMins Int      @default(60)
  description         String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([metricName, thresholdType])
  @@index([metricName, enabled])
}

enum SubscriptionTier {
  FREE
  PROFESSIONAL
  ENTERPRISE
  INSTITUTION
  HOBBY
  PRO
}

enum PlanType {
  BASIC
  PROFESSIONAL
  PREMIUM
}

enum CronJobStatus {
  STARTED
  SUCCESS
  FAILED
  TIMEOUT
  CANCELLED
}

enum CronAlertType {
  EXECUTION_FAILED
  HIGH_ERROR_RATE
  COST_THRESHOLD_EXCEEDED
  PERFORMANCE_DEGRADED
  NO_FILINGS_PROCESSED
  EMAIL_DELIVERY_FAILED
  TIMEOUT_EXCEEDED
  MEMORY_LIMIT_EXCEEDED
  API_RATE_LIMIT_HIT
  DATABASE_CONNECTION_FAILED
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ExecutionStatus {
  RUNNING
  COMPLETED
  FAILED
  SKIPPED
}

model DailyWaitlistCache {
  id        String   @id @default(uuid())
  date      DateTime @unique @db.Date
  baseCount Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
}

model DailyPipelineVerification {
  id                    String   @id @default(uuid())
  verificationDate      DateTime @db.Date
  runAt                 DateTime @default(now())

  // Filing counts
  filingsDiscovered     Int      @default(0)
  filingsCompleted      Int      @default(0)
  filingsPending        Int      @default(0)
  filingsFailed         Int      @default(0)

  // Phase breakdown
  fetchSuccessCount     Int      @default(0)
  fetchFailedCount      Int      @default(0)
  summarizeSuccessCount Int      @default(0)
  summarizeFailedCount  Int      @default(0)
  emailsSentCount       Int      @default(0)
  uniqueUsersNotified   Int      @default(0)

  // OpenRouter API costs (aggregated from summaries generated this day)
  aiTotalCostUsd        Float    @default(0)
  aiInputTokens         Int      @default(0)
  aiOutputTokens        Int      @default(0)
  aiTotalTokens         Int      @default(0)
  aiModelBreakdown      Json?    // { "model-name": { cost, inputTokens, outputTokens } }

  // Remediation stats
  remediationAttempted  Int      @default(0)
  remediationSucceeded  Int      @default(0)
  remediationFailed     Int      @default(0)

  // Detailed results (JSON array of filing verification results)
  filingDetails         Json?

  // Execution metadata
  durationMs            Int?
  errors                String[]

  @@unique([verificationDate])
  @@index([verificationDate])
  @@index([runAt])
}
