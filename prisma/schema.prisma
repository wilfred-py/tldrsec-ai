generator client {
  provider      = "prisma-client-js"
  output        = "../node_modules/.prisma/client"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String    @id @default(uuid())
  email               String    @unique
  name                String?
  authProvider        String
  authProviderId      String
  createdAt           DateTime  @default(now())
  preferences         Json?
  onboardingCompleted Boolean   @default(false)
  tutorialCompletedAt DateTime?
  tutorialProgress    Int       @default(0)
  tutorialSteps       Json?
  subscriptionTier       SubscriptionTier @default(FREE)
  lastProcessedAt        DateTime?        // Last time this user was processed by cron
  lastCronProcessed      DateTime?        // Last time processed by tier-aware cron
  processingBudget       Int              @default(0) // Monthly token budget
  budgetUsed             Int              @default(0) // Current month usage
  budgetResetAt          DateTime?        // Budget reset date
  dailyProcessingBudget  Int              @default(0) // Daily processing minutes used
  dailyBudgetResetAt     DateTime?        // Daily budget reset timestamp
  tierProcessingCount    Int              @default(0) // Total tier-based processings
  lastTierUpgrade        DateTime?        // Last subscription tier upgrade
  tickers             Ticker[]
  notificationsSent   NotificationSent[]
  userSubscription    UserSubscription?
  filingUsage         FilingUsage[]
  usagePeriods        UsagePeriod[]
  auditLogs           AuditLog[]
}

enum SubscriptionTier {
  FREE
  PROFESSIONAL
  ENTERPRISE
  INSTITUTION
}

enum PlanType {
  BASIC
  PROFESSIONAL
  PREMIUM
}

model Ticker {
  id          String      @id @default(uuid())
  symbol      String
  companyName String
  userId      String
  addedAt     DateTime    @default(now())
  secFilings  SecFiling[]
  summaries   Summary[]
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, symbol])
}

model Summary {
  id                    String     @id @default(uuid())
  tickerId              String
  filingType            String
  filingDate            DateTime
  filingUrl             String
  summaryText           String
  summaryJSON           Json?
  createdAt             DateTime   @default(now())
  sentToUser            Boolean    @default(false)
  url                   String?
  attempts              Int?       @default(0)
  cost                  Float?
  isPartialResult       Boolean?   @default(false)
  model                 String?
  processingCompletedAt DateTime?
  processingError       String?
  processingErrorCode   String?
  processingStatus      String?
  processingTimeMs      Int?
  secFilingId           String?
  tokensUsed            Int?
  metadata              Json?      // Enhanced processing metadata (chunks, strategy, etc.)
  secFiling             SecFiling? @relation(fields: [secFilingId], references: [id])
  ticker                Ticker     @relation(fields: [tickerId], references: [id], onDelete: Cascade)
}

model CikMapping {
  id              String   @id @default(uuid())
  cik             String   @unique
  ticker          String
  companyName     String
  aliases         String[]
  exchangeCodes   String[]
  sic             String?
  ein             String?
  entityType      String?
  formerNames     Json?
  formerTickers   Json?
  lastUpdated     DateTime @default(now())
  fetchAttempts   Int      @default(0)
  lastFetchStatus String?
  isActive        Boolean  @default(true)

  @@index([ticker])
  @@index([companyName])
}

model TickerChange {
  id            String   @id @default(uuid())
  oldTicker     String
  newTicker     String
  oldCik        String?
  newCik        String?
  effectiveDate DateTime
  changeType    String
  description   String?
  createdAt     DateTime @default(now())

  @@index([oldTicker])
  @@index([newTicker])
  @@index([effectiveDate])
}

model JobQueue {
  id             String    @id @default(uuid())
  jobType        String
  status         String
  priority       Int       @default(5)
  payload        Json
  idempotencyKey String?
  createdAt      DateTime  @default(now())
  scheduledFor   DateTime
  startedAt      DateTime?
  completedAt    DateTime?
  failedAt       DateTime?
  retryCount     Int       @default(0)
  maxRetries     Int       @default(3)
  lastError      String?
  executionTime  Int?
  result         Json?

  @@index([status, scheduledFor])
  @@index([jobType, status])
  @@index([idempotencyKey])
  @@index([createdAt])
}

model JobLock {
  id          String    @id @default(uuid())
  lockName    String    @unique
  acquiredBy  String
  acquiredAt  DateTime  @default(now())
  expiresAt   DateTime
  refreshedAt DateTime?
  released    Boolean   @default(false)

  @@index([lockName, released, expiresAt])
}

model SecFiling {
  id              String           @id @default(uuid())
  tickerId        String
  formType        String
  filingDate      DateTime
  secUrl          String
  accessionNumber String
  companyName     String?
  cik             String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  ticker          Ticker           @relation(fields: [tickerId], references: [id], onDelete: Cascade)
  summaries       Summary[]
  fetchAttempts   SecFetchAttempt[]

  @@index([tickerId, formType])
  @@index([accessionNumber])
}

model SecCompanyCache {
  id        Int      @id @default(1)
  data      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SecFetchAttempt {
  id           String   @id @default(uuid())
  filingId     String
  attemptedAt  DateTime
  status       String
  errorMessage String?
  filing       SecFiling @relation(fields: [filingId], references: [id], onDelete: Cascade)

  @@index([filingId])
}

model NotificationSent {
  id              String   @id @default(uuid())
  userId          String
  filingId        String?
  summaryId       String?
  notificationType String   // NEW_FILING, FILING_UPDATE, SUMMARY_READY, DAILY_DIGEST
  emailId         String?  // ID from email service (e.g., Resend)
  emailAddress    String
  sentAt          DateTime @default(now())
  deliveryStatus  String   @default("sent") // sent, delivered, bounced, complained
  metadata        Json?    // Additional tracking data
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, sentAt])
  @@index([notificationType, sentAt])
  @@index([emailId])
}

model TickerMonitoring {
  id                String   @id @default(uuid())
  cik               String   @unique
  symbol            String
  companyName       String
  isActive          Boolean  @default(true)
  rssUrl            String
  lastChecked       DateTime?
  lastAccessionSeen String?
  subscriberCount   Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  filingChecks      RssFilingCheck[]

  @@index([isActive, lastChecked])
  @@index([cik])
}

model RssFilingCheck {
  id               String   @id @default(uuid())
  tickerMonitoringId String
  accessionNumber  String
  filingType       String
  filingDate       DateTime
  filingUrl        String
  rssEntryDate     DateTime
  processed        Boolean  @default(false)
  createdAt        DateTime @default(now())
  
  tickerMonitoring TickerMonitoring @relation(fields: [tickerMonitoringId], references: [id], onDelete: Cascade)

  @@unique([accessionNumber])
  @@index([processed, createdAt])
  @@index([tickerMonitoringId, processed])
}

model UserSubscription {
  id                    String   @id @default(uuid())
  userId                String   @unique
  planType              PlanType @default(BASIC)
  isActive              Boolean  @default(true)
  currentPeriodStart    DateTime @default(now())
  currentPeriodEnd      DateTime
  cancelAtPeriodEnd     Boolean  @default(false)
  stripeCustomerId      String?  @unique
  stripeSubscriptionId  String?  @unique
  stripePriceId         String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([planType, isActive])
}

model FilingUsage {
  id                   String   @id @default(uuid())
  userId               String
  filingType           String
  ticker               String
  accessionNumber      String?
  optimizationLevel    String
  originalTokens       Int?
  optimizedTokens      Int?
  reductionPercentage  Float?
  cost                 Float?
  processingTimeMs     Int?
  subscriptionTier     String
  createdAt            DateTime @default(now())
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([subscriptionTier, createdAt])
  @@index([filingType, createdAt])
}

model UsagePeriod {
  id           String   @id @default(uuid())
  userId       String
  periodStart  DateTime
  periodEnd    DateTime
  planType     PlanType
  filingLimit  Int
  filingsUsed  Int      @default(0)
  resetAt      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, periodStart])
  @@index([userId, periodEnd])
}

// Cron Job Monitoring Models
model CronJobExecution {
  id                  String                @id @default(uuid())
  jobName             String                // "monitor-sec-filings"
  executionId         String                @unique // UUID for this specific run
  status              CronJobStatus         // STARTED, SUCCESS, FAILED, TIMEOUT
  startedAt           DateTime
  completedAt         DateTime?
  durationMs          Int?
  
  // Environment & Configuration
  environment         String                // "production", "staging" 
  cronExpression      String?               // "0 */30 6-22 * * 1-5"
  batchSize           Int?                  // 5
  maxConcurrent       Int?                  // 3
  timeoutMs           Int?                  // 240000
  
  // High-level Results  
  tickersChecked      Int                   @default(0)
  newFilingsFound     Int                   @default(0)
  filingsProcessed    Int                   @default(0)
  emailsSent          Int                   @default(0)
  errorsCount         Int                   @default(0)
  
  // Resource Usage
  memoryUsageMb       Float?
  cpuUsagePercent     Float?
  
  // Error Information
  errorMessage        String?
  errorStack          String?
  
  // Relationships
  metrics             CronJobMetrics[]
  alerts              CronJobAlert[]
  performance         CronJobPerformance[]
  
  createdAt           DateTime              @default(now())
  
  @@index([jobName, startedAt])
  @@index([status, startedAt]) 
  @@index([startedAt])
  @@index([executionId])
}

model CronJobMetrics {
  id                    String              @id @default(uuid())
  executionId           String
  execution             CronJobExecution    @relation(fields: [executionId], references: [id], onDelete: Cascade)
  
  // Filing Activity Metrics
  filingsByType         Json?               // {"10-K": 2, "10-Q": 1, "8-K": 3}
  companiesProcessed    Json?               // ["TSLA", "AAPL", "MSFT"]
  filingDates           Json?               // Array of filing dates processed
  avgProcessingTimeMs   Float?
  
  // User Impact Metrics
  usersAffected         Int                 @default(0)
  uniqueEmailRecipients Int                 @default(0)
  emailDeliveryRate     Float?              // Percentage successful
  emailBounceRate       Float?
  
  // Cost Analysis
  aiCostTotal           Float               @default(0)
  aiTokensUsed          Int                 @default(0)
  aiTokensInput         Int                 @default(0)
  aiTokensOutput        Int                 @default(0)
  emailCostTotal        Float               @default(0)
  operationalCostTotal  Float               @default(0)
  costPerFiling         Float?
  costPerUser           Float?
  
  // Performance Metrics
  avgMemoryUsageMb      Float?
  peakMemoryUsageMb     Float?
  dbQueryCount          Int?
  avgDbQueryTimeMs      Float?
  apiCallCount          Int?
  avgApiResponseTimeMs  Float?
  secApiCallCount       Int?
  avgSecApiResponseMs   Float?
  
  // Throughput Metrics
  filingsPerMinute      Float?
  emailsPerMinute       Float?
  
  createdAt             DateTime            @default(now())
  
  @@index([executionId])
}

model CronJobAlert {
  id                String              @id @default(uuid())
  executionId       String?
  execution         CronJobExecution?   @relation(fields: [executionId], references: [id], onDelete: Cascade)
  
  alertType         CronAlertType       // EXECUTION_FAILED, HIGH_ERROR_RATE, COST_THRESHOLD, PERFORMANCE_DEGRADED
  severity          AlertSeverity       // LOW, MEDIUM, HIGH, CRITICAL
  title             String
  description       String
  
  // Alert Configuration
  threshold         Json?               // Threshold values that triggered alert
  actualValue       Json?               // Actual values that triggered the alert
  
  // Alert Lifecycle
  triggeredAt       DateTime            @default(now())
  acknowledgedAt    DateTime?
  acknowledgedBy    String?             // User ID or system
  resolvedAt        DateTime?
  resolvedBy        String?
  
  // Notification
  notificationsSent Json?               // Channels where alert was sent
  notificationStatus String?            // "sent", "failed", "pending"
  
  // Metadata
  jobName           String?
  environment       String?
  
  @@index([alertType, triggeredAt])
  @@index([severity, triggeredAt])
  @@index([jobName, triggeredAt])
  @@index([resolvedAt])
}

model CronJobPerformance {
  id                  String              @id @default(uuid())
  executionId         String
  execution           CronJobExecution    @relation(fields: [executionId], references: [id], onDelete: Cascade)
  
  // Time-series data points
  timestamp           DateTime
  phase               String              // "rss_check", "filing_processing", "email_sending", "cleanup"
  
  // Performance Metrics
  memoryUsageMb       Float
  cpuUsagePercent     Float?
  activeConnections   Int?
  queueDepth          Int?
  
  // Operation-specific metrics  
  operationType       String?             // "filing_fetch", "ai_summary", "email_send", "db_query"
  operationDurationMs Int?
  operationSuccess    Boolean?
  operationError      String?
  
  // Throughput at this point
  itemsProcessed      Int?
  itemsRemaining      Int?
  
  @@index([executionId, timestamp])
  @@index([phase, timestamp])
  @@index([operationType, timestamp])
}

// Aggregated views for faster dashboard queries
model CronJobDailySummary {
  id                    String   @id @default(uuid())
  date                  DateTime @unique @db.Date
  jobName               String   
  
  // Execution Statistics
  totalExecutions       Int      @default(0)
  successfulExecutions  Int      @default(0)
  failedExecutions      Int      @default(0)
  avgDurationMs         Float?
  totalDurationMs       Int      @default(0)
  
  // Processing Statistics  
  totalFilingsProcessed Int      @default(0)
  totalEmailsSent       Int      @default(0)
  totalUsersAffected    Int      @default(0)
  
  // Cost Statistics
  totalAiCost           Float    @default(0)
  totalEmailCost        Float    @default(0)
  totalOperationalCost  Float    @default(0)
  
  // Performance Statistics
  avgMemoryUsageMb      Float?
  peakMemoryUsageMb     Float?
  totalApiCalls         Int      @default(0)
  
  // Alert Statistics
  totalAlerts           Int      @default(0)
  criticalAlerts        Int      @default(0)
  
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  
  @@index([date, jobName])
  @@index([jobName, date])
}

enum CronJobStatus {
  STARTED
  SUCCESS  
  FAILED
  TIMEOUT
  CANCELLED
}

enum CronAlertType {
  EXECUTION_FAILED
  HIGH_ERROR_RATE
  COST_THRESHOLD_EXCEEDED
  PERFORMANCE_DEGRADED
  NO_FILINGS_PROCESSED
  EMAIL_DELIVERY_FAILED
  TIMEOUT_EXCEEDED
  MEMORY_LIMIT_EXCEEDED
  API_RATE_LIMIT_HIT
  DATABASE_CONNECTION_FAILED
}

enum AlertSeverity {
  LOW
  MEDIUM  
  HIGH
  CRITICAL
}

// Tier-aware processing models
model TierProcessingMetrics {
  id                    String              @id @default(uuid())
  date                  DateTime            @default(now()) @db.Date
  tier                  SubscriptionTier    // FREE, PROFESSIONAL, ENTERPRISE, INSTITUTION
  
  // Processing Statistics
  usersProcessed        Int                 @default(0)
  usersEligible         Int                 @default(0)
  usersSkipped          Int                 @default(0)
  avgProcessingTime     Float?              // milliseconds
  filingsProcessed      Int                 @default(0)
  
  // Cost and Budget Tracking
  budgetUsed            Float               @default(0)   // Processing minutes used
  budgetLimit           Float               @default(0)   // Daily budget limit
  costPerUser           Float?              // Average cost per user
  
  // Performance Metrics
  marketHoursRuns       Int                 @default(0)
  offHoursRuns          Int                 @default(0)
  priorityProcessed     Int                 @default(0)   // Users processed at high priority
  
  // Error Tracking
  errorCount            Int                 @default(0)
  timeoutCount          Int                 @default(0)
  
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  
  @@unique([date, tier])
  @@index([date, tier])
  @@index([tier, createdAt])
}

model TierProcessingExecution {
  id                    String              @id @default(uuid())
  executionId           String              // Links to main cron execution
  tier                  SubscriptionTier
  
  // Execution Context
  isMarketHours         Boolean
  startedAt             DateTime            @default(now())
  completedAt           DateTime?
  status                ExecutionStatus     @default(RUNNING)
  
  // User Processing
  usersEligible         Int                 @default(0)
  usersProcessed        Int                 @default(0)
  usersSkipped          Int                 @default(0)
  userErrors            Int                 @default(0)
  
  // Filing Processing
  filingsFound          Int                 @default(0)
  filingsProcessed      Int                 @default(0)
  filingsErrors         Int                 @default(0)
  
  // Resource Usage
  processingTimeMs      Int?                // Total processing time
  budgetUsed            Float               @default(0)
  avgTimePerUser        Float?              // Average time per user
  
  // Performance Metrics
  batchSize             Int                 @default(0)
  priority              Int                 @default(0)
  frequency             Int                 @default(0)  // Minutes between runs
  
  errorMessage          String?
  errorStack            String?
  
  @@index([executionId])
  @@index([tier, startedAt])
  @@index([isMarketHours, tier])
}

enum ExecutionStatus {
  RUNNING
  COMPLETED
  FAILED
  SKIPPED
}

model CronExecutionContext {
  id                    String              @id @default(uuid())
  executionId           String              @unique // Links to CronJobExecution
  
  // Market Context
  isMarketHours         Boolean
  marketTimeZone        String              @default("America/New_York")
  
  // Processing Context
  totalUsersEligible    Int                 @default(0)
  tierBreakdown         Json?               // {"FREE": 100, "PROFESSIONAL": 50, ...}
  
  // Budget Context
  globalBudgetLimit     Decimal             @default(0)
  globalBudgetUsed      Decimal             @default(0)
  budgetAlerts          Json?               // Active budget alerts
  
  // Processing Results
  usersProcessedByTier  Json?               // {"FREE": 10, "PROFESSIONAL": 25, ...}
  avgProcessingByTier   Json?               // Processing times per tier
  
  // Performance Metrics
  budgetUtilization     Float?              // percentage of budget used
  avgLatency            Int                 @default(0) // milliseconds
  errorCount            Int                 @default(0)
  successRate           Float?              // percentage
  
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  
  @@index([executionId])
  @@index([isMarketHours, createdAt])
}

// Audit logging for financial and security operations
model AuditLog {
  id                    String              @id @default(uuid())
  userId                String
  action                String              // BUDGET_UPDATE, TIER_CHANGE, COST_CALCULATION, etc.
  details               Json                // Structured details of the operation
  ipAddress             String?
  userAgent             String?
  success               Boolean             @default(true)
  errorMessage          String?
  
  // Timestamps
  createdAt             DateTime            @default(now())
  
  // Relationships
  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
}
