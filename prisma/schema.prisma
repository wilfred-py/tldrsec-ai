generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String    @id @default(uuid())
  email               String    @unique
  name                String?
  authProvider        String
  authProviderId      String
  createdAt           DateTime  @default(now())
  preferences         Json?
  onboardingCompleted Boolean   @default(false)
  tutorialCompletedAt DateTime?
  tutorialProgress    Int       @default(0)
  tutorialSteps       Json?
  subscriptionTier    SubscriptionTier @default(FREE)
  tickers             Ticker[]
  notificationsSent   NotificationSent[]
}

enum SubscriptionTier {
  FREE
  PREMIUM
  ENTERPRISE
}

model Ticker {
  id          String      @id @default(uuid())
  symbol      String
  companyName String
  userId      String
  addedAt     DateTime    @default(now())
  secFilings  SecFiling[]
  summaries   Summary[]
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, symbol])
}

model Summary {
  id                    String     @id @default(uuid())
  tickerId              String
  filingType            String
  filingDate            DateTime
  filingUrl             String
  summaryText           String
  summaryJSON           Json?
  createdAt             DateTime   @default(now())
  sentToUser            Boolean    @default(false)
  url                   String?
  attempts              Int?       @default(0)
  cost                  Float?
  isPartialResult       Boolean?   @default(false)
  model                 String?
  processingCompletedAt DateTime?
  processingError       String?
  processingErrorCode   String?
  processingStatus      String?
  processingTimeMs      Int?
  secFilingId           String?
  tokensUsed            Int?
  secFiling             SecFiling? @relation(fields: [secFilingId], references: [id])
  ticker                Ticker     @relation(fields: [tickerId], references: [id], onDelete: Cascade)
}

model CikMapping {
  id              String   @id @default(uuid())
  cik             String   @unique
  ticker          String
  companyName     String
  aliases         String[]
  exchangeCodes   String[]
  sic             String?
  ein             String?
  entityType      String?
  formerNames     Json?
  formerTickers   Json?
  lastUpdated     DateTime @default(now())
  fetchAttempts   Int      @default(0)
  lastFetchStatus String?
  isActive        Boolean  @default(true)

  @@index([ticker])
  @@index([companyName])
}

model TickerChange {
  id            String   @id @default(uuid())
  oldTicker     String
  newTicker     String
  oldCik        String?
  newCik        String?
  effectiveDate DateTime
  changeType    String
  description   String?
  createdAt     DateTime @default(now())

  @@index([oldTicker])
  @@index([newTicker])
  @@index([effectiveDate])
}

model JobQueue {
  id             String    @id @default(uuid())
  jobType        String
  status         String
  priority       Int       @default(5)
  payload        Json
  idempotencyKey String?
  createdAt      DateTime  @default(now())
  scheduledFor   DateTime
  startedAt      DateTime?
  completedAt    DateTime?
  failedAt       DateTime?
  retryCount     Int       @default(0)
  maxRetries     Int       @default(3)
  lastError      String?
  executionTime  Int?
  result         Json?

  @@index([status, scheduledFor])
  @@index([jobType, status])
  @@index([idempotencyKey])
  @@index([createdAt])
}

model JobLock {
  id          String    @id @default(uuid())
  lockName    String    @unique
  acquiredBy  String
  acquiredAt  DateTime  @default(now())
  expiresAt   DateTime
  refreshedAt DateTime?
  released    Boolean   @default(false)

  @@index([lockName, released, expiresAt])
}

model SecFiling {
  id              String           @id @default(uuid())
  tickerId        String
  formType        String
  filingDate      DateTime
  secUrl          String
  accessionNumber String
  companyName     String?
  cik             String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  ticker          Ticker           @relation(fields: [tickerId], references: [id], onDelete: Cascade)
  summaries       Summary[]
  fetchAttempts   SecFetchAttempt[]

  @@index([tickerId, formType])
  @@index([accessionNumber])
}

model SecCompanyCache {
  id        Int      @id @default(1)
  data      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SecFetchAttempt {
  id           String   @id @default(uuid())
  filingId     String
  attemptedAt  DateTime
  status       String
  errorMessage String?
  filing       SecFiling @relation(fields: [filingId], references: [id], onDelete: Cascade)

  @@index([filingId])
}

model NotificationSent {
  id              String   @id @default(uuid())
  userId          String
  filingId        String?
  summaryId       String?
  notificationType String   // NEW_FILING, FILING_UPDATE, SUMMARY_READY, DAILY_DIGEST
  emailId         String?  // ID from email service (e.g., Resend)
  emailAddress    String
  sentAt          DateTime @default(now())
  deliveryStatus  String   @default("sent") // sent, delivered, bounced, complained
  metadata        Json?    // Additional tracking data
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, sentAt])
  @@index([notificationType, sentAt])
  @@index([emailId])
}

model TickerMonitoring {
  id                String   @id @default(uuid())
  cik               String   @unique
  symbol            String
  companyName       String
  isActive          Boolean  @default(true)
  rssUrl            String
  lastChecked       DateTime?
  lastAccessionSeen String?
  subscriberCount   Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  filingChecks      RssFilingCheck[]

  @@index([isActive, lastChecked])
  @@index([cik])
}

model RssFilingCheck {
  id               String   @id @default(uuid())
  tickerMonitoringId String
  accessionNumber  String
  filingType       String
  filingDate       DateTime
  filingUrl        String
  rssEntryDate     DateTime
  processed        Boolean  @default(false)
  createdAt        DateTime @default(now())
  
  tickerMonitoring TickerMonitoring @relation(fields: [tickerMonitoringId], references: [id], onDelete: Cascade)

  @@unique([accessionNumber])
  @@index([processed, createdAt])
  @@index([tickerMonitoringId, processed])
}
