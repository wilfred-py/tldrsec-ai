legacy-peer-deps=true

# Force npm to install optional dependencies during builds
optional=true

# Include dev dependencies during build phase
include=dev

# Use exact versions for better build consistency
save-exact=true

# Prefer offline packages when available
prefer-offline=true

# Configure registry settings
registry=https://registry.npmjs.org/

# Ensure platform-specific binaries are installed
target_platform=linux
target_arch=x64

# Progress and logging settings
progress=true
loglevel=notice